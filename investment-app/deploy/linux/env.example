# Claves y ajustes del Asistente de inversión. Este archivo debe tener permisos 600 (solo tú puedes leerlo).
# No lo subas nunca a ningún repositorio.

# Contraseña para entrar en la web (el instalador genera una si la dejas vacía).
APP_PASSWORD=

# Conexión con Claude: rellena una de las dos (o ambas) y elige cuál usar en la web
# (Bot de inversión > Configuración > Conexión con Claude).

# Opción 1 - Suscripción (Pro/Max): token creado con `claude setup-token` (dura un año).
CLAUDE_CODE_OAUTH_TOKEN=

# Opción 2 - API de Anthropic (pago por uso). https://platform.claude.com
ANTHROPIC_API_KEY=

# API de eToro (opcional; para la cuenta demo y la comunidad). Portal de desarrolladores de eToro.
ETORO_API_KEY=
ETORO_USER_KEY=
