[Unit]
Description=Asistente de inversión (revisión semanal de la estrategia)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@ENV_FILE@
# Para encontrar el programa `claude` (Claude Code) instalado por el instalador oficial.
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@APP_DIR@/.venv/bin/python -m invest.trading --revisar
TimeoutStartSec=1800
